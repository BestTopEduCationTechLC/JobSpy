# GitHub OAuth App credentials (github.com/settings/developers -> New OAuth App)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Must exactly match the OAuth App's "Authorization callback URL"
GITHUB_CALLBACK_URL=https://your-backend.onrender.com/auth/github/callback

# Your deployed GitHub Pages URL (no trailing slash)
FRONTEND_URL=https://besttopeducationtechlc.github.io/JobSpy

# Random long string used to sign session cookies, e.g. output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# A GitHub Personal Access Token (classic, scope: "workflow") belonging to a
# collaborator/bot account with permission to trigger Actions on this repo.
# Held only here on the server — logged-in users never see or need this.
GITHUB_BOT_TOKEN=

# Optional: comma-separated GitHub usernames allowed to log in / trigger scrapes.
# Leave blank to allow any GitHub account to log in (still fine — the scrape
# button is what's gated, and it always uses YOUR bot token either way, so
# an empty allowlist just means "anyone can log in and click the button").
ALLOWED_GITHUB_LOGINS=

# Postgres connection string (Render "New Postgres" gives you this)
DATABASE_URL=

# Optional overrides — defaults already point at this repo/branch/workflow
GH_OWNER=BestTopEduCationTechLC
GH_REPO=JobSpy
GH_WORKFLOW=scrape-jobs.yml
GH_REF=TESTING
